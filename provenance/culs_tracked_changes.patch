+std::string gate3aJsonEscape(const char * value) {
+    if (value == nullptr)
+        return "";
+    std::string result;
+    for (const char * p = value; *p != '\0'; ++p) {
+        switch (*p) {
+        case '\\': result += "\\\\"; break;
+        case '"': result += "\\\""; break;
+        case '\n': result += "\\n"; break;
+        case '\r': result += "\\r"; break;
+        case '\t': result += "\\t"; break;
+        default: result += *p; break;
+        }
+    }
+    return result;
+}
+
+void gate3aWriteIntArray(std::ofstream & out, const int * values, int length) {
+    out << '[';
+    for (int i = 0; i < length; ++i) {
+        if (i != 0)
+            out << ',';
+        out << values[i];
+    }
+    out << ']';
+}
+
