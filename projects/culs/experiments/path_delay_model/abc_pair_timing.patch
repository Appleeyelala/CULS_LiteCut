+/** Experimental source-restricted MIO timing query. */
+int Abc_CommandPrintPairDelay( Abc_Frame_t * pAbc, int argc, char ** argv )
+{
+    Abc_Ntk_t * pNtk = Abc_FrameReadNtk(pAbc);
+    Abc_Obj_t * pObjIn, * pObjOut;
+    int c, fTrace = 0, fCheck = 0, Num;
+    Extra_UtilGetoptReset();
+    while ( (c = Extra_UtilGetopt(argc, argv, "tvh")) != EOF )
+    {
+        if ( c == 't' ) fTrace = 1;
+        else if ( c == 'v' ) fCheck = 1;
+        else goto usage;
+    }
+    if ( pNtk == NULL || !Abc_NtkIsMappedLogic(pNtk) )
+    {
+        Abc_Print( -1, "print_pair_delay requires a mapped standard-cell network.\n" );
+        return 1;
+    }
+    if ( argc != globalUtilOptind + 2 )
+        goto usage;
+    Num = Nm_ManFindIdByName( pNtk->pManName, argv[globalUtilOptind], ABC_OBJ_PO );
+    if ( Num < 0 ) Num = Nm_ManFindIdByName( pNtk->pManName, argv[globalUtilOptind], ABC_OBJ_BI );
+    if ( Num < 0 )
+    {
+        Abc_Print( -1, "Cannot find combinational output \"%s\".\n", argv[globalUtilOptind] );
+        return 1;
+    }
+    pObjOut = Abc_NtkObj( pNtk, Num );
+    Num = Nm_ManFindIdByName( pNtk->pManName, argv[globalUtilOptind+1], ABC_OBJ_PI );
+    if ( Num < 0 ) Num = Nm_ManFindIdByName( pNtk->pManName, argv[globalUtilOptind+1], ABC_OBJ_BO );
+    if ( Num < 0 )
+    {
+        Abc_Print( -1, "Cannot find combinational input \"%s\".\n", argv[globalUtilOptind+1] );
+        return 1;
+    }
+    pObjIn = Abc_NtkObj( pNtk, Num );
+    return Abc_NtkPairDelayTrace( pNtk, pObjOut, pObjIn, fTrace, fCheck ) ? 0 : 1;
+usage:
+    Abc_Print( -2, "usage: print_pair_delay [-tv] <CO_name> <CI_name>\n" );
+    Abc_Print( -2, "\t-t : print source-restricted critical traceback\n" );
+    Abc_Print( -2, "\t-v : compare with all-PI PO arrival and original timing engine under single-source CI seeds\n" );
+    return 1;
+}
